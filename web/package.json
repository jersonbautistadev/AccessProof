{
  "name": "accessproof-viewer",
  "private": true,
  "version": "0.1.0",
  "description": "Static, client-side viewer for AccessProof report.json files",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "gen:validator": "node scripts/build-validator.mjs",
    "dev": "npm run gen:validator && vite",
    "typecheck": "npm run gen:validator && tsc --noEmit",
    "test": "npm run gen:validator && vitest run",
    "build": "npm run gen:validator && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
